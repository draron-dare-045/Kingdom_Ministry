# Server
PORT=4000
# Comma separated list of origins allowed to call this API.
# e.g. http://localhost:5173,https://your-live-site.com
FRONTEND_ORIGIN=http://localhost:5173

# Render Postgres connection string (free tier — remember to upgrade
# before day 30 or Render deletes the database).
# If you're using Render's own Postgres + Blueprint (render.yaml), Render
# fills this in automatically. For local dev, copy the "External
# Database URL" from your database's Info page on Render.
DATABASE_URL=

# Admin login (single admin account for the church office).
# Change these before going live.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Long random string used to sign login sessions (JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Cloudinary (free tier is plenty) — sign up at https://cloudinary.com
# Dashboard > Account Details has all three of these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
